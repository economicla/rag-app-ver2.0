# ============================================================================
# VPS Demo Environment - Supabase Postgres + OpenAI/GPT Models
# Copy to .env.vps and fill real values on the VPS.
# Do not commit .env.vps.
# ============================================================================

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8005
ENVIRONMENT=production
LOG_LEVEL=info
LOG_FILE=/app/app_refactored/logs/rag-api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Supabase PostgreSQL / pgvector
# Prefer Supabase "Connection string" with sslmode=require.
# Example:
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
POSTGRES_SSLMODE=require
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5

# Redis in docker-compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OpenAI / GPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings through OpenAI.
# Keep dimensions=2048 because the documents.embedding column is Vector(2048).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=2048
JINA_TIMEOUT=120
JINA_EMBED_BATCH_SIZE=64

# Text answer generation through GPT.
VLLM_HOST=https://api.openai.com
VLLM_PORT=0
VLLM_MODEL=gpt-4o-mini
VLLM_TIMEOUT=300

# PDF OCR / vision extraction through GPT vision model.
VLM_HOST=https://api.openai.com
VLM_PORT=0
VLM_MODEL=gpt-4o-mini
VLM_TIMEOUT=600

# RAG chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS
CORS_ORIGINS=*

# Security/audit feature flags
ENABLE_AUDIT_LOGGING=true
ENABLE_PII_DETECTION=true
DATA_CLASSIFICATION_ENABLED=true
SOFT_DELETE_ENABLED=true
